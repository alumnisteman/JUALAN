# ═══════════════════════════════════════════════════════════════
# AI COMMERCE OS — ENVIRONMENT CONFIG
# Copy file ini jadi .env di server produksi, JANGAN commit ke git.
# ═══════════════════════════════════════════════════════════════

# --- Database utama (Postgres) ---
DB_HOST=database
DB_USER=postgres
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
DB_NAME=ai_commerce

# --- ERP Database (Postgres terpisah) ---
ERP_DB_USER=erp_user
ERP_DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
ERP_DB_NAME=erp_db

# --- Meilisearch (search engine) ---
# Generate master key acak, mis: openssl rand -hex 32
MEILI_MASTER_KEY=GANTI_DENGAN_MASTER_KEY_ACAK

# --- pgAdmin (UI manajemen database, opsional) ---
PGADMIN_EMAIL=admin@ai-commerce.com
PGADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

# --- Google Gemini (AI content generation) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
WHATSAPP_NUMBER=whatsapp:+6285121097574

# --- Email (SendGrid) ---
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com

# --- Payments internasional (Stripe) ---
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY

# --- Payments lokal (Gopay) ---
GOPAY_CLIENT_ID=YOUR_GOPAY_CLIENT_ID
GOPAY_CLIENT_SECRET=YOUR_GOPAY_CLIENT_SECRET
GOPAY_MERCHANT_ID=YOUR_GOPAY_MERCHANT_ID
GOPAY_CALLBACK_URL=https://yourdomain.com/api/payment/gopay/callback

# --- TikTok Shop Open API (data produk/pesanan, BUKAN posting konten) ---
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_SHOP_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_SHOP_CLIENT_SECRET

# --- TikTok Content Posting API (auto-post video, BEDA app dari TikTok Shop) ---
# Daftar di developers.tiktok.com, ajukan produk "Content Posting API".
# JANGAN isi dengan nilai dummy 'awttslvj9382dr8j' — itu cuma data contoh di kode.
TIKTOK_CONTENT_CLIENT_KEY=ISI_CLIENT_KEY_ASLI_DARI_DEVELOPERS.TIKTOK.COM
TIKTOK_CONTENT_CLIENT_SECRET=ISI_CLIENT_SECRET_ASLI_DARI_DEVELOPERS.TIKTOK.COM
TIKTOK_REDIRECT_URI=http://192.168.1.18/api/social/tiktok/callback
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Instagram Graph API (auto-post foto/reels) ---
# Daftar Meta App di developers.facebook.com, tambah produk "Instagram Graph API",
# ajukan App Review untuk permission instagram_business_content_publish.
INSTAGRAM_APP_ID=ISI_APP_ID_ASLI_DARI_DEVELOPERS.FACEBOOK.COM
INSTAGRAM_APP_SECRET=ISI_APP_SECRET_ASLI_DARI_DEVELOPERS.FACEBOOK.COM
INSTAGRAM_REDIRECT_URI=http://192.168.1.18/api/social/instagram/callback
