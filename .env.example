# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (Docker)
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/resellerhub?authSource=admin
REDIS_URI=redis://redis:6379

# Meilisearch Configuration
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=meilisearch_master_key_change_this

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# ─── Shopee Open Platform ─────────────────────────────────────────────────────
# Daftar di: https://open.shopee.com/
SHOPEE_PARTNER_ID=your_shopee_partner_id
SHOPEE_PARTNER_KEY=your_shopee_partner_key
# Access token & shop_id disimpan per-user di database setelah OAuth flow
SHOPEE_WEBHOOK_SECRET=your_shopee_webhook_secret

# ─── Tokopedia Seller API ─────────────────────────────────────────────────────
# Daftar di: https://developer.tokopedia.com/
TOKOPEDIA_CLIENT_ID=your_tokopedia_client_id
TOKOPEDIA_CLIENT_SECRET=your_tokopedia_client_secret
# Access token disimpan per-user di database setelah OAuth flow
TOKOPEDIA_WEBHOOK_SECRET=your_tokopedia_webhook_secret

# ─── TikTok Shop API ─────────────────────────────────────────────────────────
# Daftar di: https://partner.tiktokshop.com/
TIKTOK_APP_KEY=your_tiktok_app_key
TIKTOK_APP_SECRET=your_tiktok_app_secret
# Access token & shop_id disimpan per-user di database setelah OAuth flow
TIKTOK_WEBHOOK_SECRET=your_tiktok_webhook_secret

# ─── Notification Services ────────────────────────────────────────────────────

# WhatsApp Business API (Meta Cloud API)
# Daftar di: https://developers.facebook.com/docs/whatsapp/cloud-api/
WHATSAPP_API_KEY=your_whatsapp_bearer_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Telegram Bot
# Buat bot via @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
